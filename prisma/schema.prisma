generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  pollVotes     PollVote[]

  // Acceso al panel /admin (spec CMS §4). Una cuenta sin `role` no entra; se crean con `npm run admin:create`.
  role           String?
  passwordHash   String?
  /// Secreto TOTP cifrado (AES-256-GCM, `secret-box`). Vale como segundo factor solo con `totpEnabledAt`.
  totpSecret     String?
  totpEnabledAt  DateTime?
  /// Último paso TOTP aceptado: un código no sirve dos veces.
  totpLastStep   Int       @default(0)
  /// Sube al cambiar la contraseña o el 2FA: invalida las sesiones emitidas antes.
  sessionVersion Int       @default(0)
  recoveryCodes  AdminRecoveryCode[]
  auditLogs      AdminAuditLog[]
  cmsDocuments   CmsDocument[]
  cmsVersions    CmsVersion[]
}

/// Contenido editado en el panel (spec CMS §3). Es una capa encima de los archivos de `src/content`: lo publicado
/// aquí gana al archivo; sin fila, vale el archivo. `kind` + `key` identifican el documento (`article` + slug).
model CmsDocument {
  id          String    @id @default(cuid())
  kind        String
  key         String
  /// Borrador en curso (aún no visible en la web). `null` si no hay cambios sin publicar.
  draft       Json?
  /// Lo que ve la web. `null` si nunca se publicó.
  published   Json?
  /// Oculta el documento (también el archivo de base, si lo hay).
  deleted     Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  updatedById String?
  updatedBy   User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  versions    CmsVersion[]

  @@unique([kind, key])
  @@index([kind, deleted])
}

/// Historial: una fila por publicación (o borrado), para poder restaurar.
model CmsVersion {
  id         String      @id @default(cuid())
  documentId String
  /// Lo publicado en ese momento; `null` si la versión es un borrado.
  data       Json?
  note       String?
  createdAt  DateTime    @default(now())
  authorId   String?
  author     User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  document   CmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

/// Código de recuperación del 2FA: de un solo uso; solo se guarda su hash.
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
}

/// Rastro del panel: entradas, fallos, publicaciones… `ipHash` es un HMAC de la red, nunca la IP.
model AdminAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  ipHash    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, ipHash, createdAt])
  @@index([action, userId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Voto anónimo de la encuesta semanal de /comunidad. La encuesta vive en el contenido (no en la base);
/// `pollId` es "<semana ISO>-<a>-vs-<b>". `userId` queda vacío hasta que existan cuentas.
model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  option    String
  voterKey  String
  ipHash    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([pollId, voterKey])
  @@unique([pollId, userId])
  @@index([pollId, option])
  @@index([pollId, ipHash])
}
