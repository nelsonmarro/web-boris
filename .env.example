# Cadena de conexión a PostgreSQL (Prisma). Ej.: postgresql://root:root@localhost:5432/webboris
DATABASE_URL=
# Secreto de Auth.js para firmar sesiones (generar con: npx auth secret)
AUTH_SECRET=
# URL base que usa Auth.js (en local: http://localhost:3131)
AUTH_URL=http://localhost:3131
# URL pública del sitio, usada en metadataBase / Open Graph (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3131
# API key de Resend para enviar el formulario de contacto
RESEND_API_KEY=
# Correo de Boris que recibe los mensajes del formulario de contacto
CONTACT_EMAIL=
# Remitente del correo de contacto; en producción usar un dominio verificado en Resend
CONTACT_FROM_EMAIL=Universos de BorisaoBlois <onboarding@resend.dev>
